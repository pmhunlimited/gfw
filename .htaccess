RewriteEngine On
RewriteBase /

# Check if config exists to decide if we should go to installer
# However, .htaccess can't easily check for file existence of another directory and redirect based on that logic easily for PHP flow.
# We'll let root index.php handle the initial redirection if someone hits /

RewriteRule ^$ migrate/index.php [L]

RewriteCond %{REQUEST_URI} !^/migrate/
RewriteRule ^(.*)$ migrate/$1 [L]
